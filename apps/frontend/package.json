{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "infisicalLauncher --path=/microCms/solid/local -- vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "infisicalLauncher --path=/microCms/solid/local -- yarn vitest run --coverage",
    "test:e2e": "yarn playwright test",
    "test:e2e:ui": "yarn playwright test --ui",
    "generate:api-types": "openapi-typescript ../backend/openApi/openapi.yaml -o src/schema/apiTypes.ts && yarn generate:api-aliases",
    "generate:api-aliases": "node scripts/generate-api-aliases.mjs",
    "check": "yarn generate:api-types && yarn typecheck && yarn lint && yarn format && yarn test && yarn test:e2e"
  },
  "dependencies": {
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.14",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "@tabler/icons-solidjs": "^3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/solid-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "jose": "^6.2.12",
    "lucide-solid": "^1.52.0",
    "solid-js": "^1.9.16",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "concurrently": "10.0.5",
    "dotenv-cli": "11.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-solid": "0.18.1",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "infisicalLauncher": "git+ssh://git@github.com:user-komeda/infisicalLauncher.git",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0"
}
